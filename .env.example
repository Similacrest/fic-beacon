# Calibre library path (absolute path to your Calibre library folder).
# Mounted READ-ONLY into the app; READ-WRITE into the fetcher container only.
CALIBRE_LIBRARY_PATH=/path/to/your/calibre/library

# Where the fetcher's FanFicFare personal.ini (site logins) lives. Defaults to ./fetcher/config.
# FETCHER_CONFIG_PATH=/path/to/fetcher/config

# Run the fetcher as your Calibre library's owner so new EPUBs/folders match it instead of
# root:root (the fetcher is the sole writer). Find the values with:
#   stat -c '%u:%g' "$CALIBRE_LIBRARY_PATH"
# Unset → 0:0 (root), the previous behaviour.
# FETCHER_UID=1000
# FETCHER_GID=1000

# Fetcher service URL (the isolated FanFicFare + calibredb container).
# BEACON_FETCHER_URL=http://fetcher:8080
# Fetches are async (FanFicFare can take ~15 min): how often to poll a running job, and
# when to give up on one (seconds).
# BEACON_FETCHER_POLL_INTERVAL=30
# BEACON_FETCHER_JOB_TIMEOUT=1200
# Fetcher container only — base seconds for its 3-try exponential backoff on transient errors.
# FETCHER_RETRY_BASE_SECONDS=30

# Optional: change the default port
BEACON_PORT=8000

# Optional: set your domain (used in feed generation)
BEACON_BASE_URL=http://localhost:8000

# Optional: a separate origin for the feedback links (🪝 👍 👎 ⏸ ❌ ✓) — only /fb/* must be
# reachable there. Feeds, /read, /img and WebSub stay on BEACON_BASE_URL. Default: BEACON_BASE_URL.
# BEACON_FEEDBACK_BASE_URL=https://fb.example.com
# Origins that older drops have baked into their image URLs (comma-separated); /img/ URLs on them
# are rewritten to BEACON_BASE_URL and signed when rendered.
# BEACON_LEGACY_BASE_URLS=https://old.example.com

# Optional: serve /websub/* without the proxy token (the proxy must publish /websub/ too).
# BEACON_PUBLIC_WEBSUB=true

# Optional: timezone for drop/poll schedules (IANA name, e.g. Europe/Tallinn).
# Unset → UTC in a stock container.
# BEACON_TZ=Europe/Tallinn

# Optional: feed secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# BEACON_FEED_SECRET=your-secret-here

# Reverse-proxy shared secret (proxy sends it as X-Beacon-Proxy-Token). Required for admin access:
# BEACON_PROXY_TOKEN=generate-with-secrets.token_urlsafe
# Local dev on loopback without a token: BEACON_BIND_HOST=127.0.0.1
# Trusted-network / no-proxy Docker use (NO auth on /admin — never expose the port): BEACON_ADMIN_OPEN=true

# Shared secret between beacon and the fetcher (recommended; both containers read it):
# FETCHER_TOKEN=generate-with-secrets.token_urlsafe

# Run beacon as a non-root user (optional; see docker-compose.yml):
# BEACON_UID=1000
# BEACON_GID=1000
# Optional WebSub callback host allowlist (callbacks are always https + public-address only):
# BEACON_WEBSUB_CALLBACK_HOSTS=incoming.inoreader.com
